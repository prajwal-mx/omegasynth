#!/usr/bin/env python3
"""
OmegaSynth SYNTCOMP Master Competitive Solver (v2 — Zero External Dependencies)
Executes the native C++20 AVX2 OmegaSynth engine with built-in Mealy HOA game-tree expansion,
extended-peeling Zielonka, and wave-parallel SCC decomposition.
"""

import os
import sys
import subprocess

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
OMEGA_BIN = os.path.join(SCRIPT_DIR, "omegasynth")

def main():
    if len(sys.argv) < 2:
        print("Usage: omegasynth_syntcomp <file.ehoa> [--emit-aiger]")
        sys.exit(1)

    emit_aiger = ("--emit-aiger" in sys.argv) or ("--aiger" in sys.argv)
    filepath = [a for a in sys.argv[1:] if not a.startswith("--")][-1]
    if not os.path.exists(filepath):
        print(f"Error: file not found: {filepath}", file=sys.stderr)
        sys.exit(1)

    cmd = [OMEGA_BIN, "hoa", filepath, "--zielonka", "--preprocess", "--syntcomp"]
    if emit_aiger:
        cmd.append("--emit-aiger")
    res = subprocess.run(cmd)
    sys.exit(res.returncode)

if __name__ == "__main__":
    main()
